      "name": "Normalize Email Lead"
    },
    {
      "parameters": {
        "jsCode": "// Pre-filter: marks obvious spam before AI, so we don't spend tokens on it\n\nconst OWN_EMAILS = ['you@example.com']; // your inbox address(es)\n\nconst DISPOSABLE_DOMAINS = [\n  'mailinator.com', 'guerrillamail.com', 'guerrillamail.net', 'sharklasers.com',\n  '10minutemail.com', 'tempmail.com', 'temp-mail.org', 'temp-mail.io',\n  'yopmail.com', 'trashmail.com', 'getnada.com', 'maildrop.cc',\n  'dispostable.com', 'throwawaymail.com', 'fakeinbox.com', 'mailnesia.com',\n  'burnermail.io', 'emailondeck.com', 'mohmal.com', 'tempmailo.com'\n];\n\nconst NO_REPLY = /^(no[-_.]?reply|do[-_.]?not[-_.]?reply|mailer-daemon|postmaster)@/i;\nconst EMAIL_FORMAT = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nconst email = String($json.email || '').trim().toLowerCase();\nconst message = String($json.message || '').trim();\nconst domain = email.split('@')[1] || '';\nconst emailWithoutTag = email.replace(/\\+[^@]*@/, '@'); // you+leads@ -> you@\n\nlet spamReason = '';\n\nif (!EMAIL_FORMAT.test(email)) {\n  spamReason = 'invalid_email';\n} else if (message.length < 15) {\n  spamReason = 'message_too_short';\n} else if (DISPOSABLE_DOMAINS.some(d => domain === d || domain.endsWith('.' + d))) {\n  spamReason = 'disposable_email';\n} else if (OWN_EMAILS.includes(emailWithoutTag)) {\n  spamReason = 'own_email';\n} else if (NO_REPLY.test(email)) {\n  spamReason = 'no_reply';\n}\n\nreturn {\n  json: {\n    ...$json,\n    email,\n    category: spamReason ? 'spam' : '',\n    spam_reason: spamReason,\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
