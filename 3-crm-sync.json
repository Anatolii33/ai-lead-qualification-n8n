    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Build Note: prepares the HubSpot API request for a \"repeat inquiry\" note\n\nconst lead = $('Scored Lead').item.json;\nconst upsert = $('Upsert Contact').item.json;\nconst contactId = upsert.vid ?? upsert.id;\n\n// lead text is untrusted: escape HTML so it can't break the note\nconst esc = s => String(s ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nconst lines = [\n  `<b>Repeat inquiry</b> via ${esc(lead.source)}`,\n  `Score: ${lead.total_score} (${esc(lead.category)})`,\n  `Summary: ${esc(lead.summary)}`,\n  `Next action: ${esc(lead.next_action)}`,\n  '',\n  '<b>Message:</b>',\n  ...esc(lead.message).split(/\\r?\\n/),\n];\n\nreturn {\n  json: {\n    properties: {\n      hs_timestamp: new Date().toISOString(),\n      hs_note_body: lines.join('<br>'),\n    },\n    associations: [\n      {\n        to: { id: contactId },\n        types: [{ associationCategory: 'HUBSPOT_DEFINED', associationTypeId: 202 }],\n      },\n    ],\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        448
      ],
      "id": "ccc2b4e3-f911-48b3-8aa6-573e8a649f8f",
      "name": "Build Note"
    },
